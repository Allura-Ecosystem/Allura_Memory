+import { Buffer } from 'node:buffer'
+import { classifyPostgresError, DatabaseQueryError, DatabaseUnavailableError } from '../../lib/errors/database-errors'
+import type { MemoryExportRequest, MemoryExportResponse, MemoryGetResponse } from '../../lib/memory/canonical-contracts'
+import { permissionDenied, type Execute } from './deterministic-search'
+
+export const MAX_EXPORT_OFFSET = 100000
+
+// Fetch each source in the SAME ID order used by the merge, before applying the
+// global offset. With unique IDs per source, the first offset+limit+1 IDs from
+// each source suffice for the merged page, even with cross-source collisions.
+export const SEMANTIC_EXPORT_SQL = `
+SELECT m.id::text AS id, m.content, m.score, m.provenance, m.user_id,
+       m.created_at, m.version, m.tags, 'semantic'::text AS source
+FROM graph_memories m
+WHERE m.group_id=$1 AND m.workspace_id=$2 AND m.workspace_scope_state='workspace_scoped'
+  AND ($4::boolean=false OR m.user_id=$3)
+  AND m.deleted_at IS NULL AND m.deprecated=false
+  AND NOT EXISTS (
+    SELECT 1 FROM graph_supersedes s
+    WHERE s.group_id=$1 AND s.workspace_id=$2
+      AND s.workspace_scope_state='workspace_scoped' AND s.superseded_id=m.id)
+ORDER BY m.id::text COLLATE "C" ASC LIMIT $5`
+
+export const EPISODIC_EXPORT_SQL = `
+WITH records AS (
+  SELECT DISTINCT ON (e.metadata->>'memory_id')
+    e.metadata->>'memory_id' AS id, e.metadata->>'content' AS content,
+    0.5::float8 AS score, e.metadata->>'source' AS provenance,
+    e.metadata->>'user_id' AS user_id, e.created_at, 1 AS version,
+    e.metadata->'tags' AS tags, 'episodic'::text AS source
+  FROM events e
+  WHERE e.group_id=$1 AND e.workspace_id=$2
+    AND e.event_type='memory_add' AND e.metadata->>'user_id'=$3
+    AND ($4::boolean=false OR e.metadata->>'user_id'=$3)
+    AND e.metadata->>'memory_id' IS NOT NULL
+    AND COALESCE((
+      SELECT l.event_type FROM events l
+      WHERE l.group_id=$1 AND l.workspace_id=$2 AND l.metadata->>'user_id'=$3
+        AND l.metadata->>'memory_id'=e.metadata->>'memory_id'
+        AND l.event_type IN ('memory_delete','memory_restore')
+      ORDER BY l.created_at DESC, l.id DESC LIMIT 1
+    ), 'memory_restore') <> 'memory_delete'
+  ORDER BY e.metadata->>'memory_id', e.created_at ASC, e.id ASC
+)
+SELECT * FROM records ORDER BY id COLLATE "C" ASC LIMIT $5`
+
+/** Scope is supplied by the authenticated MCP boundary, never caller arguments. */
+export function validateExportRequest(request: MemoryExportRequest) {
+  const scope = request.scope
+  if (!/^allura-[a-z0-9_-]+$/.test(request.group_id)
+    || !scope || scope.group_id !== request.group_id
+    || typeof scope.workspace_id !== 'string' || !scope.workspace_id.trim()
+    || typeof scope.agent_id !== 'string' || !scope.agent_id.trim()) {
+    throw new Error('verified MCP workspace scope is required')
+  }
+  if (request.user_id !== undefined && request.user_id !== scope.agent_id) {
+    throw new Error('permission denied: principal mismatch')
+  }
+  if (request.canonical_only !== undefined && typeof request.canonical_only !== 'boolean') throw new Error('canonical_only must be boolean')
+  if (request.format !== undefined && request.format !== 'json') throw new Error('only json export is supported')
+  const requestedLimit = request.limit ?? 1000
+  const offset = request.offset ?? 0
+  if (!Number.isSafeInteger(requestedLimit) || requestedLimit < 1) throw new Error('limit must be a positive safe integer')
+  if (!Number.isSafeInteger(offset) || offset < 0 || offset > MAX_EXPORT_OFFSET) throw new Error(`offset must be an integer between 0 and ${MAX_EXPORT_OFFSET}`)
+  return { workspaceId: scope.workspace_id, principalId: scope.agent_id, limit: Math.min(requestedLimit, 10000), offset }
+}
+
+function mapExportRow(row: Record<string, any>): MemoryGetResponse {
+  const date = new Date(row.created_at)
+  const score = Number(row.score), version = Number(row.version)
+  if (typeof row.id !== 'string' || !row.id || typeof row.content !== 'string'
+    || !Number.isFinite(date.getTime()) || !Number.isFinite(score) || score < 0 || score > 1
+    || !Number.isSafeInteger(version) || version < 1
+    || !['semantic', 'episodic'].includes(row.source)) throw new Error('invalid export record')
+  let tags = row.tags
+  if (typeof tags === 'string') { try { tags = JSON.parse(tags) } catch { tags = [] } }
+  return {
+    id: row.id, content: row.content, score, source: row.source,
+    provenance: row.provenance === 'manual' ? 'manual' : 'conversation',
+    user_id: row.user_id ?? '', created_at: date.toISOString(), version,
+    usage_count: 0, recent_usage_count: null,
+    tags: Array.isArray(tags) ? tags.filter((tag: unknown) => typeof tag === 'string') : [],
+  } as MemoryGetResponse
+}
+
+function queryCanceled(error: unknown): boolean {
+  const seen = new Set<object>()
+  let current = error
+  while (current !== null && typeof current === 'object' && !seen.has(current)) {
+    seen.add(current)
+    const detail = current as { code?: unknown; cause?: unknown }
+    if (detail.code === '57014') return true
+    current = detail.cause
+  }
+  return false
+}
+
+/** Executes only through a restricted, tenant/workspace/principal-bound executor. */
+export async function scopedExport(request: MemoryExportRequest, execute: Execute, backend: string): Promise<MemoryExportResponse> {
+  const { workspaceId, principalId, limit, offset } = validateExportRequest(request)
+  const values = [request.group_id, workspaceId, principalId, request.user_id !== undefined, offset + limit + 1]
+  const attempted: ('graph' | 'postgres')[] = [], used: ('graph' | 'postgres')[] = [], warnings: string[] = []
+  let rows: MemoryGetResponse[] = []
+  async function source(store: 'graph' | 'postgres', sql: string) {
+    attempted.push(store)
+    let result
+    try { result = await execute(sql, values) }
+    catch (error) {
+      // Never convert authorization denials or retired/programming errors into
+      // a successful partial export or an apparent backend outage.
+      if (permissionDenied(error)) throw error
+      if (queryCanceled(error)) {
+        throw new DatabaseQueryError(`memory_export:${store}`, sql, error instanceof Error ? error : new Error(String(error)))
+      }
+      if (!(error instanceof DatabaseUnavailableError)) {
+        const classified = classifyPostgresError(error instanceof Error ? error : new Error(String(error)), `memory_export:${store}`, sql)
+        if (!(classified instanceof DatabaseUnavailableError)) throw classified
+      }
+      if (request.canonical_only) throw error instanceof DatabaseUnavailableError ? error : new DatabaseUnavailableError('memory_export:graph', error as Error)
+      warnings.push(`${store}_unavailable`)
+      return
+    }
+    const mapped = result.rows.map(mapExportRow)
+    rows = rows.concat(mapped)
+    used.push(store)
+  }
+  if (backend !== 'ruvector') {
+    // This repair is deliberately not a resurrection of the retired graph API.
+    if (request.canonical_only) throw new Error('memory_export: unsupported graph backend')
+    warnings.push('unsupported_graph_backend')
+  } else await source('graph', SEMANTIC_EXPORT_SQL)
+  if (!request.canonical_only) await source('postgres', EPISODIC_EXPORT_SQL)
+  if (used.length === 0) throw new DatabaseUnavailableError('memory_export:no_sources')
+
+  // Semantic wins by memory ID, independent of timestamps and page boundaries.
+  const unique = new Map<string, MemoryGetResponse>()
+  for (const row of rows) if (!unique.has(row.id) || row.source === 'semantic') unique.set(row.id, row)
+  const pageLimited = unique.size > offset + limit
+  const memories = [...unique.values()]
+    .sort((a, b) => Buffer.compare(Buffer.from(a.id), Buffer.from(b.id)))
+    .slice(offset, offset + limit)
+  const canonicalCount = memories.filter(row => row.source === 'semantic').length
+  return {
+    memories, count: memories.length, exported_at: new Date().toISOString(),
+    canonical_count: canonicalCount, episodic_count: memories.length - canonicalCount,
+    meta: {
+      contract_version: 'v1', degraded: warnings.length > 0,
+      ...(warnings.includes('graph_unavailable') ? { degraded_reason: 'graph_unavailable' as const } : {}),
+      stores_used: used, stores_attempted: attempted, warnings,
+      covered_sources: used.map(store => store === 'graph' ? 'current_semantic' : 'principal_episodic'),
+      coverage_limitations: ['id_order_offset_pagination_not_snapshot_isolated', ...(pageLimited ? ['export_page_limited'] : []), ...warnings],
+      incomplete: warnings.length > 0 || pageLimited,
+    },
+  }
+}
