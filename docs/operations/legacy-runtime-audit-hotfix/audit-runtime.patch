+/** Project only authenticated authority; tool arguments can never select a workspace. */
+export function auditToolContextFromPrincipal(
+  principal: Pick<PrincipalContext, "workspaceId" | "principalId">,
+): AuditToolContext {
+  const workspaceId = String(principal.workspaceId ?? "").trim()
+  const principalId = String(principal.principalId ?? "").trim()
+  if (!workspaceId) throw new Error("authenticated principal has no verified workspace binding")
+  if (!principalId) throw new Error("authenticated principal id is required")
+  return { workspaceId, principalId }
+}
+
+function requireAuditScope(groupId: GroupId, context?: AuditToolContext) {
+  const workspaceId = String(context?.workspaceId ?? "").trim()
+  const principalId = String(context?.principalId ?? "").trim()
+  if (!workspaceId || !principalId) {
+    throw new Error("verified workspace_id and principal_id are required for audit access")
+  }
+  return { tenantId: groupId, workspaceId, principalId }
