+import type { MemorySearchRequest, MemorySearchResponse, MemorySearchResult } from '../../lib/memory/canonical-contracts'
+
+export const RETRIEVAL_CONFIG = 'pg-scoped-lexical-v1'
+// No embedding dependency or query-time timestamps. Literal matching uses strpos,
+// so %, _ and backslashes are data, never LIKE wildcards.
+export const EPISODIC_SQL = `
+WITH records AS (
+ SELECT DISTINCT ON (e.metadata->>'memory_id')
+   e.metadata->>'memory_id' AS id, e.metadata->>'content' AS content,
+   0.5::float8 AS score, e.metadata->>'source' AS provenance,
+   e.created_at, 1 AS version, e.metadata->'tags' AS tags,
+   'episodic'::text AS source
+ FROM events e
+ WHERE e.group_id=$1 AND e.workspace_id=$2
+   AND e.event_type='memory_add' AND e.metadata->>'user_id'=$3
+   AND e.metadata->>'memory_id' IS NOT NULL
+   AND NOT EXISTS (
+     SELECT 1 FROM events d WHERE d.group_id=$1 AND d.workspace_id=$2
+       AND d.metadata->>'memory_id'=e.metadata->>'memory_id'
+       AND d.metadata->>'user_id'=$3 AND d.event_type='memory_delete'
+       AND NOT EXISTS (SELECT 1 FROM events r
+         WHERE r.group_id=$1 AND r.workspace_id=$2
+           AND r.metadata->>'memory_id'=d.metadata->>'memory_id'
+           AND r.metadata->>'user_id'=$3 AND r.event_type='memory_restore'
+           AND r.created_at>d.created_at))
+ ORDER BY e.metadata->>'memory_id', e.created_at ASC, e.id ASC
+), ranked AS (
+ SELECT *, CASE WHEN lower(id)=lower($4) THEN 3.0
+   WHEN strpos(lower(content),lower($4))>0 THEN 2.0
+   ELSE ts_rank(to_tsvector('english',content),plainto_tsquery('english',$4)) END AS relevance
+ FROM records WHERE lower(id)=lower($4) OR strpos(lower(content),lower($4))>0
+   OR to_tsvector('english',content) @@ plainto_tsquery('english',$4)
+)
+SELECT * FROM ranked WHERE score >= $5
+ORDER BY relevance DESC, created_at DESC, id COLLATE "C" ASC, version ASC LIMIT $6`
+
+export const SEMANTIC_SQL = `
+WITH ranked AS (
+ SELECT m.id::text, m.content, m.score, m.provenance, m.created_at,
+   m.version, m.tags, 'semantic'::text AS source,
+   CASE WHEN lower(m.id::text)=lower($4) THEN 3.0
+     WHEN strpos(lower(m.content),lower($4))>0 THEN 2.0
+     WHEN m.content_tsv @@ plainto_tsquery('english',$4)
+       THEN 1.0+ts_rank(m.content_tsv,plainto_tsquery('english',$4))
+     ELSE GREATEST(word_similarity($4,m.content),strict_word_similarity($4,m.content)) END AS relevance
+ FROM graph_memories m
+ WHERE m.group_id=$1 AND m.workspace_id=$2 AND m.workspace_scope_state='workspace_scoped'
+   AND ($7::boolean=false OR m.user_id=$3)
+   AND m.deleted_at IS NULL
+   AND (m.deprecated=false OR EXISTS (SELECT 1 FROM graph_supersedes s
+     WHERE s.group_id=$1 AND s.workspace_id=$2 AND s.workspace_scope_state='workspace_scoped'
+       AND s.superseded_id=m.id))
+   AND ($8::text <> 'approved' OR (m.deprecated=false AND NOT EXISTS (
+     SELECT 1 FROM graph_supersedes s WHERE s.group_id=$1 AND s.workspace_id=$2
+       AND s.workspace_scope_state='workspace_scoped' AND s.superseded_id=m.id)))
+   AND (lower(m.id::text)=lower($4) OR strpos(lower(m.content),lower($4))>0
+     OR m.content_tsv @@ plainto_tsquery('english',$4)
+     OR word_similarity($4,m.content)>=0.15 OR strict_word_similarity($4,m.content)>=0.15)
+)
+SELECT * FROM ranked WHERE score >= $5
+ORDER BY relevance DESC, created_at DESC, id COLLATE "C" ASC, version ASC LIMIT $6`
+
+// Read existing explicit edges only. Include both endpoints even when the old
+// wording does not match the query. Never infer an edge from dates or prose.
+export const HISTORY_SQL = `
+SELECT s.newer_id::text, s.superseded_id::text,
+ row_to_json(n) AS newer, row_to_json(p) AS predecessor
+FROM graph_supersedes s
+JOIN graph_memories n ON n.id=s.newer_id AND n.group_id=s.group_id AND n.workspace_id=s.workspace_id
+JOIN graph_memories p ON p.id=s.superseded_id AND p.group_id=s.group_id AND p.workspace_id=s.workspace_id
+WHERE s.group_id=$1 AND s.workspace_id=$2 AND s.workspace_scope_state='workspace_scoped'
+ AND n.workspace_scope_state='workspace_scoped' AND p.workspace_scope_state='workspace_scoped'
+ AND n.deleted_at IS NULL AND p.deleted_at IS NULL
+ AND ($4::boolean=false OR (n.user_id=$3 AND p.user_id=$3))
+ AND (s.newer_id::text=ANY($5::text[]) OR s.superseded_id::text=ANY($5::text[]))
+ORDER BY s.newer_id::text COLLATE "C", s.superseded_id::text COLLATE "C" LIMIT 201`
+
+type Row = Record<string, any>
+export type Execute = (sql: string, values: unknown[]) => Promise<{ rows: Row[] }>
+
+export function permissionDenied(error: unknown): boolean {
+ const seen = new Set<unknown>()
+ for (let e: any = error; e && !seen.has(e); e=e.cause) {
+   seen.add(e)
+   if (e.code === '42501' || String(e.code).startsWith('28') || e.status === 401 || e.status === 403
+     || /permission|forbidden|unauthori[sz]ed|access.denied/i.test(`${e.name || ''} ${e.message || ''}`)) return true
+ }
+ return false
+}
+
+function mapRow(row: Row): MemorySearchResult {
+ const timestamp = new Date(row.created_at)
+ if (!row.id || typeof row.content !== 'string' || !Number.isFinite(timestamp.getTime())
+   || !Number.isInteger(Number(row.version)) || Number(row.version)<1
+   || !Number.isFinite(Number(row.score))) throw new Error('invalid retrieval record')
+ let tags = row.tags
+ if (typeof tags === 'string') { try { tags = JSON.parse(tags) } catch { tags=[] } }
+ return {
+   id: row.id, content: row.content, score: Number(row.score), source: row.source,
+   provenance: row.provenance === 'manual' ? 'manual' : 'conversation',
+   created_at: timestamp.toISOString(), version: Number(row.version), usage_count: 0,
+   tags: Array.isArray(tags) ? tags.filter((t: unknown) => typeof t === 'string') : [],
+   relevance: Number(row.relevance || 0),
+ }
+}
+const cmp = (a: string,b: string) => a<b ? -1 : a>b ? 1 : 0
+export function mergeRows(rows: MemorySearchResult[], limit: number): MemorySearchResult[] {
+ const sorted = [...rows].sort((a,b) => (b.relevance! - a.relevance!)
+   || Date.parse(b.created_at)-Date.parse(a.created_at) || cmp(a.id,b.id)
+   || a.version!-b.version! || cmp(a.source,b.source) || cmp(a.content,b.content))
+ const seen = new Set<string>()
+ return sorted.filter(r => { const key=JSON.stringify([r.id,r.version]); if(seen.has(key)) return false; seen.add(key); return true }).slice(0,limit)
+}
+
+/** Caller supplies a transaction executor bound to verified tenant/workspace/principal. */
+export async function deterministicSearch(request: MemorySearchRequest, execute: Execute, backend: string): Promise<MemorySearchResponse> {
+ const start=Date.now(), scope=request.scope
+ if (!scope?.workspace_id || !scope.agent_id || scope.group_id!==request.group_id) throw new Error('verified MCP workspace scope is required')
+ if (request.user_id && request.user_id!==scope.agent_id) throw new Error('permission denied: principal mismatch')
+ if (typeof request.query!=='string' || !request.query.trim()) throw new Error('query must be nonempty')
+ const limit=request.limit ?? 10, min=request.min_score ?? 0
+ if (!Number.isInteger(limit) || limit<1 || limit>100) throw new Error('limit must be an integer between 1 and 100')
+ if (!Number.isFinite(min) || min<0 || min>1) throw new Error('min_score must be between 0 and 1')
+ const status=request.status ?? 'all'
+ if (!['all','approved','proposed','deprecated'].includes(status)) throw new Error('invalid retrieval status')
+ const warnings: string[] = [], covered: string[] = [], limitations: string[] = ['embedding_similarity_not_covered','index_revision_unavailable','data_revision_unavailable','episodic_relationships_not_available']
+ const stores: ('postgres'|'graph')[] = [], attempted: ('postgres'|'graph')[] = []
+ const values=[request.group_id,scope.workspace_id,scope.agent_id,request.query.trim(),min,limit+1]
+ let rows: MemorySearchResult[]=[]
+ async function source(name: 'postgres'|'graph',sql: string,args: unknown[]) {
+   attempted.push(name)
+   try {
+     const result=await execute(sql,args)
+     const mapped=result.rows.map(mapRow)
+     if(mapped.length>limit) limitations.push(`${name}_results_limited`)
+     rows.push(...mapped.slice(0,limit)); stores.push(name)
+     covered.push(name==='postgres'?'episodic_keyword':'semantic_keyword_fts_trigram')
+   } catch(error) { if(permissionDenied(error)) throw new Error('permission denied: retrieval stopped'); warnings.push(`${name}_unavailable`); limitations.push(`${name}_unavailable`) }
+ }
+ if(status!=='approved') await source('postgres',EPISODIC_SQL,values)
+ if(backend==='ruvector') await source('graph',SEMANTIC_SQL,[...values,!!request.user_id,status])
+ else { warnings.push('unsupported_graph_backend'); limitations.push('semantic_coverage_unavailable') }
+ if(request.include_global !== false) limitations.push('global_scope_not_expanded')
+ if(status==='proposed' || status==='deprecated') limitations.push('legacy_status_filter_not_supported')
+ const results=mergeRows(rows,limit)
+ if(stores.includes('graph') && results.length>0) {
+   try {
+     const history=await execute(HISTORY_SQL,[request.group_id,scope.workspace_id,scope.agent_id,!!request.user_id,results.map(r=>r.id)])
+     if(history.rows.length>200) limitations.push('history_results_limited')
+     for(const result of results) {
+       result.relationships=history.rows.slice(0,200).filter(e=>e.newer_id===result.id || e.superseded_id===result.id).map(e=>({
+         type:'supersedes' as const, newer_id:e.newer_id, predecessor_id:e.superseded_id,
+         newer:mapRow({...e.newer,source:'semantic'}), predecessor:mapRow({...e.predecessor,source:'semantic'}),
+       }))
+     }
+     covered.push('explicit_semantic_lineage')
+   } catch(error) { if(permissionDenied(error)) throw new Error('permission denied: retrieval stopped'); warnings.push('history_unavailable'); limitations.push('history_unavailable') }
+ }
+ return {results,count:results.length,latency_ms:Date.now()-start,meta:{contract_version:'v1',degraded:warnings.length>0,
+   stores_used:stores,stores_attempted:attempted,warnings,covered_sources:covered,coverage_limitations:limitations,
+   incomplete:true,retrieval_config_version:RETRIEVAL_CONFIG,index_revision:null,data_revision:null}}
+}
