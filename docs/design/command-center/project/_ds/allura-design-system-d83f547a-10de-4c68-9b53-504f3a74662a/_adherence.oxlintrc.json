{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/**",
              "components/core/**",
              "components/feedback/**",
              "components/memory/**",
              "components/navigation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|size|disabled|fullWidth|iconLeft|iconRight|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: kind, size, disabled, fullWidth, iconLeft, iconRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:primary|secondary|ghost|destructive)$/]",
        "message": "<Button> kind must be one of 'primary' | 'secondary' | 'ghost' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|action|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, description, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|title|meta|label|key|ref|className|style|children)$/]",
        "message": "<EvidenceCard> doesn't accept that prop. Declared props: type, title, meta, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceCard'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:file|event|decision)$/]",
        "message": "<EvidenceCard> type must be one of 'file' | 'event' | 'decision'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GraphNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|label|size|selected|key|ref|className|style|children)$/]",
        "message": "<GraphNode> doesn't accept that prop. Declared props: type, label, size, selected."
      },
      {
        "selector": "JSXOpeningElement[name.name='GraphNode'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:memory|insight|event|decision|agent|project|document)$/]",
        "message": "<GraphNode> type must be one of 'memory' | 'insight' | 'event' | 'decision' | 'agent' | 'project' | 'document'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InsightCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|title|description|meta|confidence|actions|key|ref|className|style|children)$/]",
        "message": "<InsightCard> doesn't accept that prop. Declared props: state, title, description, meta, confidence, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='InsightCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:candidate|approved|rejected)$/]",
        "message": "<InsightCard> state must be one of 'candidate' | 'approved' | 'rejected'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoadingState'] > JSXAttribute > JSXIdentifier[name!=/^(?:lines|avatar|card|key|ref|className|style|children)$/]",
        "message": "<LoadingState> doesn't accept that prop. Declared props: lines, avatar, card."
      },
      {
        "selector": "JSXOpeningElement[name.name='MemoryCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|meta|source|state|accent|key|ref|className|style|children)$/]",
        "message": "<MemoryCard> doesn't accept that prop. Declared props: label, title, meta, source, state, accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='MemoryCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|selected|superseded)$/]",
        "message": "<MemoryCard> state must be one of 'default' | 'selected' | 'superseded'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NodeMetaItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<NodeMetaItem> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReviewQueueCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|queueRef|title|meta|confidence|actions|key|ref|className|style|children)$/]",
        "message": "<ReviewQueueCard> doesn't accept that prop. Declared props: state, queueRef, title, meta, confidence, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReviewQueueCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:pending|reviewing|approved)$/]",
        "message": "<ReviewQueueCard> state must be one of 'pending' | 'reviewing' | 'approved'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|defaultValue|onChange|shortcut|width|key|ref|className|style|children)$/]",
        "message": "<SearchBar> doesn't accept that prop. Declared props: placeholder, value, defaultValue, onChange, shortcut, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|count|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: id, label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|icon|label|count|key|ref|className|style|children)$/]",
        "message": "<SidebarItem> doesn't accept that prop. Declared props: id, icon, label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|active|collapsed|count|key|ref|className|style|children)$/]",
        "message": "<SidebarNavItem> doesn't accept that prop. Declared props: icon, label, active, collapsed, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|dot|children|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: status, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:approved|active|pending|candidate|processing|rejected|superseded|error)$/]",
        "message": "<StatusBadge> status must be one of 'approved' | 'active' | 'pending' | 'candidate' | 'processing' | 'rejected' | 'superseded' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SystemHealthCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|status|statusLabel|value|unit|sublabel|key|ref|className|style|children)$/]",
        "message": "<SystemHealthCard> doesn't accept that prop. Declared props: name, status, statusLabel, value, unit, sublabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='SystemHealthCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:online|processing|offline)$/]",
        "message": "<SystemHealthCard> status must be one of 'online' | 'processing' | 'offline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|count|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopNavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:onSearch|searchPlaceholder|initials|notifications|left|key|ref|className|style|children)$/]",
        "message": "<TopNavBar> doesn't accept that prop. Declared props: onSearch, searchPlaceholder, initials, notifications, left."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
