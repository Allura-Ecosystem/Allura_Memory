{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "objective": {
      "type": "string",
      "pattern": "\\S"
    },
    "scope": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "revision": {
      "type": "string",
      "pattern": "\\S"
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "blocked",
        "done"
      ]
    },
    "acceptance": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "pattern": "\\S"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "id",
          "text",
          "evidenceIds"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "kind": {
            "type": "string",
            "enum": [
              "test",
              "review",
              "docs",
              "acceptance"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "pass",
              "fail"
            ]
          },
          "revision": {
            "type": "string",
            "pattern": "\\S"
          },
          "artifact": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "revision",
          "artifact"
        ],
        "additionalProperties": false
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "nextAction": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "objective",
    "scope",
    "outOfScope",
    "revision",
    "state",
    "acceptance",
    "checks",
    "blockers",
    "nextAction"
  ],
  "additionalProperties": false
}
