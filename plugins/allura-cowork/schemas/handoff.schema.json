{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allura.local/schemas/allura-cowork-handoff.schema.json",
  "title": "Allura Cowork Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "from_runtime",
    "to_runtime",
    "goal",
    "context_searched",
    "project_overlay",
    "files",
    "decisions",
    "open_risks",
    "validation",
    "next_action",
    "memory_status",
    "approval_needed"
  ],
  "properties": {
    "from_runtime": {
      "type": "string",
      "enum": ["Claude", "Codex", "OpenCode", "OpenClaw", "Other"]
    },
    "to_runtime": {
      "type": "string",
      "enum": ["Claude", "Codex", "OpenCode", "OpenClaw", "None", "Other"]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "context_searched": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["searched", "unavailable", "not_needed"]
        },
        "group_id": {
          "type": "string",
          "pattern": "^allura-[a-z0-9-]+$"
        },
        "queries": {
          "type": "array",
          "items": {"type": "string"}
        },
        "memory_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "project_overlay": {
      "type": "string",
      "enum": ["Team RAM", "Durham", "TALON", "IRIS", "None", "Unknown", "Other"]
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "changed"],
      "properties": {
        "read": {
          "type": "array",
          "items": {"type": "string"}
        },
        "changed": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "open_risks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "commands"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "partial", "not_run"]
        },
        "commands": {
          "type": "array",
          "items": {"type": "string"}
        },
        "evidence_paths": {
          "type": "array",
          "items": {"type": "string"}
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "memory_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["written", "not_written", "unavailable"]
        },
        "memory_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "approval_needed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
