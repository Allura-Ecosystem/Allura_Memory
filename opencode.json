{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "bellard": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "subagent",
      "model": "ollama/qwen3-coder-next:cloud",
      "path": ".opencode/agent/subagents/code/bellard.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "brooks": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "primary",
      "model": "ollama/glm-5.2:cloud",
      "path": ".opencode/agent/core/brooks.md",
      "permission": {
        "skill": {
          "*": "allow"
        },
        "task": "allow"
      }
    },
    "carmack": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "subagent",
      "model": "ollama/qwen3-coder-next:cloud",
      "path": ".opencode/agent/subagents/code/carmack.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "fowler": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "subagent",
      "model": "ollama/qwen3-coder-next:cloud",
      "path": ".opencode/agent/subagents/review/fowler.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "hightower": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "subagent",
      "model": "ollama/qwen3-coder-next:cloud",
      "path": ".opencode/agent/subagents/infrastructure/hightower.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "jobs": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "primary",
      "model": "ollama/glm-5.2:cloud",
      "path": ".opencode/agent/core/jobs.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "knuth": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "subagent",
      "model": "ollama/qwen3-coder-next:cloud",
      "path": ".opencode/agent/subagents/infrastructure/knuth.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "pike": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "subagent",
      "model": "ollama/qwen3-coder-next:cloud",
      "path": ".opencode/agent/subagents/review/pike.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "scout": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "subagent",
      "model": "ollama/nemotron-3-super:cloud",
      "path": ".opencode/agent/subagents/core/scout.md",
      "permission": {
        "edit": "allow",
        "skill": {
          "*": "allow"
        },
        "task": "allow",
        "write": "allow"
      }
    },
    "woz": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "subagent",
      "model": "ollama/qwen3-coder-next:cloud",
      "path": ".opencode/agent/subagents/code/woz.md",
      "permission": {
        "skill": {
          "*": "allow"
        },
        "task": "allow"
      }
    }
  },
  "default_agent": "brooks",
  "instructions": [
    ".opencode/AGENTS.md",
    ".opencode/manifest.json",
    ".opencode/SKILL-OWNERSHIP.md",
    ".opencode/context/core/context-system.md",
    ".opencode/context/navigation.md",
    ".opencode/agent/core/brooks.md",
    ".opencode/agent/core/jobs.md",
    ".opencode/runtime-contract.json",
    ".agents/TEAM-RAM-RUNTIME.md",
    ".opencode/COWORK.md"
  ],
  "mcp": {
    "allura-brain": {
      "enabled": true,
      "timeout": 60000,
      "type": "remote",
      "url": "http://localhost:5888/mcp"
    },
    "chrome-devtools": {
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "type": "local"
    }
  },
  "model": "ollama/glm-5.1:cloud",
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "external_directory": "allow",
    "glob": "allow",
    "grep": "allow",
    "question": "deny",
    "read": "allow",
    "skill": {
      "*": "allow",
      "allura-memory-skill": "allow",
      "mcp-docker": "allow",
      "team-ram-cowork": "allow"
    },
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "write": "allow"
  },
  "plugin": [
    "opencode-scheduler"
  ],
  "provider": {
    "ollama": {
      "models": {
        "deepseek-v3.2:cloud": {
          "name": "deepseek-v3.2:cloud"
        },
        "deepseek-v4-flash:cloud": {
          "name": "deepseek-v4-flash:cloud"
        },
        "deepseek-v4-pro:cloud": {
          "name": "deepseek-v4-pro:cloud"
        },
        "gemma4:31b-cloud": {
          "name": "gemma4:31b-cloud"
        },
        "glm-5.1:cloud": {
          "name": "glm-5.1:cloud"
        },
        "glm-5:cloud": {
          "name": "glm-5:cloud"
        },
        "gpt-oss:120b-cloud": {
          "name": "gpt-oss:120b-cloud"
        },
        "kimi-k2.5:cloud": {
          "name": "kimi-k2.5:cloud"
        },
        "kimi-k2.6:cloud": {
          "name": "kimi-k2.6:cloud"
        },
        "minimax-m2.5:cloud": {
          "name": "minimax-m2.5:cloud"
        },
        "minimax-m2.7:cloud": {
          "name": "minimax-m2.7:cloud"
        },
        "ministral-3:8b-cloud": {
          "name": "ministral-3:8b-cloud"
        },
        "nemotron-3-super:cloud": {
          "name": "nemotron-3-super:cloud"
        },
        "nomic-embed-text:latest": {
          "name": "nomic-embed-text:latest"
        },
        "qwen3-coder-next:cloud": {
          "name": "qwen3-coder-next:cloud"
        },
        "qwen3-coder:480b-cloud": {
          "name": "qwen3-coder:480b-cloud"
        },
        "qwen3-embedding:8b": {
          "name": "qwen3-embedding:8b"
        },
        "qwen3-vl:235b-cloud": {
          "name": "qwen3-vl:235b-cloud"
        },
        "qwen3.5:397b-cloud": {
          "name": "qwen3.5:397b-cloud"
        },
        "qwen3:0.6b": {
          "name": "qwen3:0.6b"
        },
        "glm-5.2:cloud": {
          "name": "glm-5.2:cloud"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "chunkTimeout": 60000,
        "timeout": 600000
      }
    },
    "openai": {
      "options": {
        "chunkTimeout": 60000,
        "timeout": 600000
      }
    }
  },
  "skills": {
    "paths": [
      ".opencode/skills",
      ".claude/skills"
    ]
  }
}
