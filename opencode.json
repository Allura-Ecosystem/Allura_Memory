{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "bellard": {
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "path": ".opencode/agent/subagents/code/bellard.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      },
      "prompt": "{file:./.opencode/agent/subagents/code/bellard.md}"
    },
    "brooks": {
      "mode": "primary",
      "model": "openai/gpt-6.1-sol",
      "path": ".opencode/agent/core/brooks.md",
      "permission": {
        "skill": {
          "*": "allow"
        },
        "task": "allow"
      },
      "prompt": "{file:./.opencode/agent/core/brooks.md}"
    },
    "carmack": {
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "path": ".opencode/agent/subagents/code/carmack.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      },
      "prompt": "{file:./.opencode/agent/subagents/code/carmack.md}"
    },
    "fowler": {
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "path": ".opencode/agent/subagents/review/fowler.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      },
      "prompt": "{file:./.opencode/agent/subagents/review/fowler.md}"
    },
    "hightower": {
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "path": ".opencode/agent/subagents/infrastructure/hightower.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      },
      "prompt": "{file:./.opencode/agent/subagents/infrastructure/hightower.md}"
    },
    "jobs": {
      "mode": "primary",
      "model": "openai/gpt-6.1-sol",
      "path": ".opencode/agent/core/jobs.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      },
      "prompt": "{file:./.opencode/agent/core/jobs.md}"
    },
    "knuth": {
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "path": ".opencode/agent/subagents/infrastructure/knuth.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      },
      "prompt": "{file:./.opencode/agent/subagents/infrastructure/knuth.md}"
    },
    "pike": {
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "path": ".opencode/agent/subagents/review/pike.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      },
      "prompt": "{file:./.opencode/agent/subagents/review/pike.md}"
    },
    "scout": {
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "path": ".opencode/agent/subagents/core/scout.md",
      "permission": {
        "edit": "allow",
        "skill": {
          "*": "allow"
        },
        "task": "allow",
        "write": "allow"
      },
      "prompt": "{file:./.opencode/agent/subagents/core/scout.md}"
    },
    "woz": {
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol",
      "path": ".opencode/agent/subagents/code/woz.md",
      "permission": {
        "skill": {
          "*": "allow"
        },
        "task": "allow"
      },
      "prompt": "{file:./.opencode/agent/subagents/code/woz.md}"
    }
  },
  "default_agent": "brooks",
  "instructions": [
    ".opencode/STARTUP.md",
    ".opencode/context/navigation.md"
  ],
  "mcp": {
    "mcp-docker": {
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run"
      ],
      "enabled": true,
      "timeout": 60000,
      "type": "local"
    },
    "chrome-devtools": {
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "type": "local"
    }
  },
  "model": "openai/gpt-6.1-sol",
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "external_directory": "allow",
    "glob": "allow",
    "grep": "allow",
    "question": "deny",
    "read": "allow",
    "skill": {
      "*": "allow",
      "allura-memory-skill": "allow",
      "mcp-docker": "allow",
      "team-ram-cowork": "allow"
    },
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "write": "allow"
  },
  "plugin": [
    "opencode-scheduler"
  ],
  "provider": {
    "openai": {
      "options": {
        "chunkTimeout": 60000,
        "timeout": 600000
      }
    }
  },
  "skills": {
    "paths": [
      ".opencode/skills",
      ".claude/skills",
      "../allura-team-durham/team-durham-plugin/skills",
      "../allura-team-ram/.opencode/skills"
    ]
  },
  "small_model": "openai/gpt-6-luna"
}
