{
  "scenario_id": "engineering-review-recovery",
  "schema_version": "v1",
  "description": "Engineering review agent recovery case: a transient tool failure is retried via checkpoint resume and the review completes",
  "tenant_fixture": {
    "group_id": "allura-engineering-review",
    "cleanup": true
  },
  "principal_fixture": {
    "principal_id": "review-agent",
    "roles": ["curator"],
    "tenant_ids": ["allura-engineering-review"],
    "auth_method": "service_identity"
  },
  "process_definition": {
    "id": "engineering-review",
    "revision": "1"
  },
  "initial_state": {
    "memories": [
      { "content": "Approved coding standard: TypeScript strict mode required", "score": 0.95 }
    ],
    "proposals": [
      { "content": "Review evidence proposal", "score": 0.88, "tier": "mainstream", "status": "pending" }
    ]
  },
  "tool_fixtures": [
    {
      "tool_name": "memory_search",
      "match": "ordered",
      "response": { "result": { "results": [{ "id": "std-1", "content": "Approved coding standard", "score": 0.95 }] } }
    },
    {
      "tool_name": "memory_add",
      "match": "ordered",
      "error": { "code": "TRANSIENT_RETRY", "message": "Evidence store temporarily unavailable" }
    },
    {
      "tool_name": "memory_add",
      "match": "ordered",
      "response": { "result": { "id": "ev-recovered", "stored": "episodic" } }
    },
    {
      "tool_name": "governance_proposal_approve",
      "match": "ordered",
      "response": { "result": { "outcome": "approved", "memory_id": "canonical-review-recovered" } }
    }
  ],
  "virtual_clock": {
    "start_time": "2026-01-01T00:00:00.000Z",
    "tick_interval_ms": 500
  },
  "random_seed": 42,
  "policy_expectations": [],
  "assertions": {
    "output": { "expected_status": "completed" },
    "state": { "proposal_status": "approved" },
    "audit": { "expected_events": ["proposal_approved"] }
  },
  "approval_breakpoints": [
    { "at_step": 2, "decision": "approve", "rationale": "Recovered from transient failure, evidence complete" }
  ]
}
