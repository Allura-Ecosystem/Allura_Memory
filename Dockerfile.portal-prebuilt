FROM node:22-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3200

# Copy the pre-built standalone (with server.js + traced node_modules)
COPY .next/standalone ./
# Turbopack mangles externals (e.g. pg-587764f78a6c7a9c) beyond what
# outputFileTracing resolves; overlay the full dependency tree so every
# external resolves at runtime.
COPY node_modules ./node_modules
# Copy static assets
COPY .next/static ./.next/static

EXPOSE 3200

CMD ["node", "server.js"]