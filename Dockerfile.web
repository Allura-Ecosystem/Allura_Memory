# Standalone web candidate only. No change to existing services or auth policy.
FROM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS base

FROM base AS build
WORKDIR /build
COPY package.json bun.lock ./
COPY packages ./packages
RUN bun install --frozen-lockfile --ignore-scripts
COPY next.config.ts next-env.d.ts tsconfig.json env.mjs ./
COPY src ./src
COPY public ./public
COPY scripts ./scripts
COPY tests ./tests
COPY vitest.config.ts eslint.config.mjs ./
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 ALLURA_WEB_STANDALONE=1
# Public browser configuration only. Never pass a secret key as a build argument.
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
RUN --network=none if [ -z "$NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY" ]; then unset NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY; fi; \
    bun --bun ./node_modules/next/dist/bin/next build --webpack

FROM base AS runtime
WORKDIR /app
COPY --from=build --chown=bun:bun /build/.next/standalone ./
COPY --from=build --chown=bun:bun /build/.next/static ./.next/static
COPY --from=build --chown=bun:bun /build/public ./public
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3100 HOSTNAME=0.0.0.0
USER bun
EXPOSE 3100
CMD ["bun", "--no-install", "server.js"]
