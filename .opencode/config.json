{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "instructions": [
    ".opencode/STARTUP.md",
    ".opencode/context/navigation.md"
  ],
  "mcp": {
    "allura-brain": {
      "type": "remote",
      "url": "http://localhost:5888/mcp"
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": "allow",
    "edit": "allow",
    "write": "allow",
    "skill": {
      "allura-memory-skill": "allow",
      "mcp-docker": "allow",
      "team-ram-cowork": "allow",
      "*": "allow"
    },
    "task": "allow"
  },
  "agent": {
    "brooks": {
      "mode": "primary",
      "path": ".opencode/agent/core/brooks.md",
      "model": "openai/gpt-6.1-sol",
      "permission": {
        "task": "allow",
        "skill": {
          "*": "allow"
        }
      },
      "prompt": "{file:./agent/core/brooks.md}"
    },
    "jobs": {
      "mode": "primary",
      "path": ".opencode/agent/core/jobs.md",
      "model": "openai/gpt-6.1-sol",
      "permission": {
        "skill": {
          "*": "allow"
        }
      },
      "prompt": "{file:./agent/core/jobs.md}"
    },
    "scout": {
      "mode": "subagent",
      "path": ".opencode/agent/subagents/core/scout.md",
      "model": "openai/gpt-6-luna",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "task": "allow",
        "skill": {
          "*": "allow"
        }
      },
      "prompt": "{file:./agent/subagents/core/scout.md}"
    },
    "woz": {
      "mode": "subagent",
      "path": ".opencode/agent/subagents/code/woz.md",
      "model": "openai/gpt-6.1-sol",
      "permission": {
        "task": "allow",
        "skill": {
          "*": "allow"
        }
      },
      "prompt": "{file:./agent/subagents/code/woz.md}"
    },
    "bellard": {
      "mode": "subagent",
      "path": ".opencode/agent/subagents/code/bellard.md",
      "model": "openai/gpt-6-luna",
      "permission": {
        "skill": {
          "*": "allow"
        }
      },
      "prompt": "{file:./agent/subagents/code/bellard.md}"
    },
    "carmack": {
      "mode": "subagent",
      "path": ".opencode/agent/subagents/code/carmack.md",
      "model": "openai/gpt-6-luna",
      "permission": {
        "skill": {
          "*": "allow"
        }
      },
      "prompt": "{file:./agent/subagents/code/carmack.md}"
    },
    "pike": {
      "mode": "subagent",
      "path": ".opencode/agent/subagents/review/pike.md",
      "model": "openai/gpt-6-luna",
      "permission": {
        "skill": {
          "*": "allow"
        }
      },
      "prompt": "{file:./agent/subagents/review/pike.md}"
    },
    "fowler": {
      "mode": "subagent",
      "path": ".opencode/agent/subagents/review/fowler.md",
      "model": "openai/gpt-6-luna",
      "permission": {
        "skill": {
          "*": "allow"
        }
      },
      "prompt": "{file:./agent/subagents/review/fowler.md}"
    },
    "knuth": {
      "mode": "subagent",
      "path": ".opencode/agent/subagents/infrastructure/knuth.md",
      "model": "openai/gpt-6-luna",
      "permission": {
        "skill": {
          "*": "allow"
        }
      },
      "prompt": "{file:./agent/subagents/infrastructure/knuth.md}"
    },
    "hightower": {
      "mode": "subagent",
      "path": ".opencode/agent/subagents/infrastructure/hightower.md",
      "model": "openai/gpt-6-luna",
      "permission": {
        "skill": {
          "*": "allow"
        }
      },
      "prompt": "{file:./agent/subagents/infrastructure/hightower.md}"
    }
  },
  "small_model": "openai/gpt-6-luna"
}
