{
  "$schema": "https://opencode.ai/config.json",
  "yolo": true,
  "model": "gpt-5.5",
  "instructions": [
    ".opencode/AGENTS.md",
    ".opencode/manifest.json",
    ".opencode/SKILL-OWNERSHIP.md",
    "_bmad/ALLURA-NAVIGATOR-WORKFLOW.md",
    ".opencode/context/core/context-system.md",
