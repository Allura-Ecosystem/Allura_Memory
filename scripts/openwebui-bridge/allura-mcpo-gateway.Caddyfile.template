# allura-mcpo-gateway.Caddyfile.template
# Per-coworker Bearer token gateway in front of mcpo (loopback :8001).
#
# VERSION NOTE: requires Caddy v2.5+; v2.7+ recommended for the filter log
# format module used below (Authorization header redaction). The map directive
# and admin reload endpoint are available from v2.5.
#
# DO NOT use this file directly. Render it via install-token-gateway.sh, which
# splices the COWORKER_TOKENS region from ~/.config/allura/coworker-tokens and
# writes the result to ~/.config/allura/allura-mcpo-gateway.Caddyfile after
# caddy validate. Use mint-coworker-token.sh to add/revoke tokens at runtime.

{
    admin localhost:2020
}

:8000 {
    # Map the full Authorization header value to a coworker user_id.
    # Tokens are injected between the markers by the render scripts.
    map {http.request.header.Authorization} {coworker_id} {
        # >>> COWORKER_TOKENS >>>
        # Regenerated by install-token-gateway.sh / mint-coworker-token.sh.
        # <<< COWORKER_TOKENS <<<
        default ""
    }

    log_append coworker_id {coworker_id}

    # Pike #3: 401 gate — unrecognised or absent Bearer token rejected first.
    @unauthorized expression `{coworker_id} == ""`
    handle @unauthorized {
        header Content-Type application/json
        respond `{"error":"unauthorized","message":"Valid Bearer token required"}` 401
    }

    # Pike #4: path allow-list — only /docs*, /openapi.json*, and /memory_*
    # reach mcpo. Every other path returns 404, even for authenticated callers.
    @allowed path /docs* /openapi.json* /memory_*
    handle @allowed {
        reverse_proxy 127.0.0.1:8001 {
            header_up Authorization "Bearer {$MCPO_API_KEY}"
            header_up X-Allura-Coworker-Id {coworker_id}
        }
    }

    # Fall-through: authenticated but disallowed path.
    handle {
        respond 404
    }

    # Pike #5: access log with Authorization header redacted.
    log {
        output file {$HOME}/.local/share/allura/logs/mcpo-gateway-access.log {
            roll_size 10mb
            roll_keep 5
        }
        format filter {
            wrap json
            fields {
                request.headers.Authorization delete
            }
        }
    }
}
