[Unit]
Description=Allura Curator Watchdog (scores events into proposals; BLOCKER alert when queue depth > threshold)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/media/ronin704/Games/Projects/Allura-ecosystem/allura-memory
Environment=WATCHDOG_QUEUE_DEPTH_THRESHOLD=50
ExecStart=/home/ronin704/.bun/bin/bun src/curator/watchdog.ts --interval 1800 --group-id allura-system
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
