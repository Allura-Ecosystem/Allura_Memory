# Allura Memory — Portfolio demo environment (non-secret example).
# This is deliberately non-secret and only supports a disposable, loopback-only
# local demo. Do not place production credentials in this file.

# ── PostgreSQL (portfolio demo stack) ────────────────────────────────────────
# Host port is loopback-only and configurable so it cannot collide with the
# primary 5432 stack. The app role password is fixed by migration 35.
PORTFOLIO_POSTGRES_PORT=5433
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=allura
POSTGRES_USER=allura
POSTGRES_PASSWORD=allura-portfolio-local-only
POSTGRES_APP_USER=allura_app
POSTGRES_APP_PASSWORD=change-me-in-production
POSTGRES_POOL_MAX=10

# ── Dashboard (Next.js) ──────────────────────────────────────────────────────
ALLURA_DASHBOARD_PORT=3100

# ── Dev auth (local only; never active in production) ────────────────────────
ALLURA_DEV_AUTH_ENABLED=true
# Explicitly prefer local DevAuth for this demo when .env.local has Clerk keys.
# Production always rejects this setting.
ALLURA_DEMO_DEV_AUTH_FORCE=true
ALLURA_DEV_AUTH_ROLE=admin
ALLURA_DEV_AUTH_GROUP_ID=allura-system
ALLURA_DEV_AUTH_WORKSPACE_ID=workspace-allura
ALLURA_DEV_AUTH_USER_ID=dev-user-allura
ALLURA_DEV_AUTH_EMAIL=dev@allura.local

# ── Optional curator module (default off) ─────────────────────────────────────
# BUMBLEBEE_MODULE_ENABLED=true
