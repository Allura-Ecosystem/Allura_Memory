# AD-71 evaluation image only. No primary deployment changes or host env files.
FROM oven/bun:1.3.14
WORKDIR /app
COPY package.json bun.lock tsconfig.json ./
COPY packages ./packages
RUN bun install --frozen-lockfile
COPY src ./src
COPY scripts/first-use-local-fixture.ts ./scripts/first-use-local-fixture.ts
# Secrets are trial-only mounted files; their values are never build arguments.
COPY <<'EOF' /app/first-use-entry.ts
import { readFileSync } from "node:fs";
import { parseFirstUseRuntimeSecrets } from "./scripts/first-use-local-fixture.ts";
let secrets;
try {
  secrets = parseFirstUseRuntimeSecrets(readFileSync("/run/secrets/first_use_mcp", "utf8"));
} catch {
  process.stderr.write("First-use secret configuration invalid\n");
  process.exit(1);
}
process.env.POSTGRES_APP_PASSWORD = secrets.POSTGRES_APP_PASSWORD;
process.env.POSTGRES_PASSWORD = secrets.POSTGRES_APP_PASSWORD;
process.env.ALLURA_MCP_TOKEN_SECRET = secrets.ALLURA_MCP_TOKEN_SECRET;
process.env.RUVIX_CONTROL_PLANE_SECRET = secrets.RUVIX_CONTROL_PLANE_SECRET;
await import("./src/mcp/canonical-http-gateway.ts");
EOF
EXPOSE 6487
CMD ["bun", "/app/first-use-entry.ts"]
