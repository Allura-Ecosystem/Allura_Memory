# Allura Memory — Environment Variables Template
# Copy this to .env and fill in real values.
# DO NOT commit .env with real credentials.

# =============================================================================
# PostgreSQL (Episodic Store — required)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=allura
POSTGRES_USER=allura
POSTGRES_PASSWORD=<required — no default>
POSTGRES_POOL_MAX=10
DATABASE_URL=postgresql://allura:<required-password>@localhost:5432/allura

# =============================================================================
# Neo4j (Semantic Store — required)
# =============================================================================
# NEO4J_URI must use the bolt:// scheme for the neo4j-driver against a
# single-instance server. The neo4j:// scheme is the routing scheme for
# clusters and HANGS the bolt driver on a non-cluster server (proven
# 2026-06-12, see docs/governance/promotion-receipts/2026-06-12-neo4j-promotion-retry.md).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<required — no default>
NEO4J_DATABASE=neo4j

# =============================================================================
# Governance (required for promotion)
# =============================================================================
# Promotion mode: "soc2" (human-gated review) or "auto" (auto-promote at threshold)
PROMOTION_MODE=soc2
AUTO_APPROVAL_THRESHOLD=0.85

# =============================================================================
# Security (required for production)
# =============================================================================
JWT_SECRET=$(openssl rand -base64 32)
ENCRYPTION_KEY=$(openssl rand -hex 32)

# =============================================================================
# RuVix ControlPlane Secret (required for controlPlane protection)
# =============================================================================
RUVIX_CONTROL_PLANE_SECRET=<required — minimum 32 characters for production>

# Migration escape hatch (AD-40): set to "true" to route memory() writes to the
# direct adapter backend instead of syscall_mutate. Leave unset in normal operation.
# The pre-rename name MEMORY_BYPASS_KERNEL is still read as a deprecated fallback.
# MEMORY_BYPASS_CONTROL_PLANE=true

# =============================================================================
# Ollama API (required for cloud embedding models)
# =============================================================================
OLLAMA_API_KEY=<required if using Ollama cloud — get from https://ollama.com/settings/keys>
OLLAMA_CLOUD_URL=https://ollama.com

# =============================================================================
# Embeddings (required for vector search)
# =============================================================================
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:8b
# Runtime embedding service URL used by RuVector embedding code.
# For host execution use http://localhost:11434.
# For Docker services use http://host.docker.internal:11434 with extra_hosts host-gateway.
RUVECTOR_EMBEDDING_BASE_URL=http://localhost:11434

# Alternative: OpenAI
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-your-key

# Alternative: Voyage
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_MODEL=voyage-3
# VOYAGE_API_KEY=your-voyage-key

# =============================================================================
# MCP HTTP Gateway (optional — defaults shown)
# =============================================================================
ALLURA_MCP_HTTP_PORT=3201
OPENCLAW_PORT=3201

# =============================================================================
# Allura Guard MCP token signing (REQUIRED to mint/verify MCP bearer tokens)
# =============================================================================
# HMAC-SHA256 key used to hash MCP tokens (raw tokens are never stored). Must be
# >=16 chars. Generate with: openssl rand -base64 32
# Allura Guard refuses to mint or verify tokens if this is unset (fail-closed).
ALLURA_MCP_TOKEN_SECRET=<required — minimum 16 characters, e.g. openssl rand -base64 32>

# =============================================================================
# MCP transport authentication - Story 24.2 (Authenticated Principal Context)
# =============================================================================
# Every MCP request resolves a verified PrincipalContext at the transport
# boundary. Tool arguments (group_id, user_id, curator_id, role) are resource
# selectors ONLY - they never grant authority.
#
# HTTP gateway (src/mcp/canonical-http-gateway.ts) picks a mode in this order:
#   1. ALLURA_MCP_TOKEN_SECRET set (>=16 chars) -> per-caller hashed credentials
#      from the mcp_tokens table. PREFERRED. Supports revocation and expiry.
#   2. ALLURA_MCP_AUTH_TOKEN set -> legacy single shared bearer token.
#   3. ALLURA_MCP_DEV_AUTH=true  -> explicit local-dev principal, NO credential.
#
# In production (NODE_ENV=production or ALLURA_ENV=production) the gateway
# REFUSES TO START if neither 1 nor 2 is present, and refuses to start at all if
# ALLURA_MCP_DEV_AUTH=true is set.

# --- Legacy shared bearer token (optional, backwards compatible) -------------
# RESIDUAL GAP (Story 24.2, review Finding 5): the shared token has NO per-caller
# identity and NO revocation path - AC-8 revocation covers mcp_tokens rows only.
# It is therefore honoured ONLY when it is the active mode. If you set
# ALLURA_MCP_TOKEN_SECRET, mode 1 wins and this token is IGNORED (the gateway
# logs an [auth-config] warning at startup). Operator guidance: once you have
# minted mcp_tokens credentials, UNSET ALLURA_MCP_AUTH_TOKEN.
# ALLURA_MCP_AUTH_TOKEN=
# Identity granted to a valid shared-token caller:
# ALLURA_MCP_SHARED_TOKEN_PRINCIPAL=shared-bearer
# ALLURA_MCP_SHARED_TOKEN_TENANTS=allura-system
# ALLURA_MCP_SHARED_TOKEN_ROLES=viewer          # viewer|curator|admin, comma separated

# --- Explicit local development mode (NEVER set in production) --------------
# ALLURA_MCP_DEV_AUTH=true
# ALLURA_MCP_DEV_PRINCIPAL_ID=dev-local
# ALLURA_MCP_DEV_TENANTS=*                      # '*' = any well-formed allura-* tenant
# ALLURA_MCP_DEV_ROLES=admin,curator,viewer

# --- stdio / service transport (src/mcp/memory-server-canonical.ts) ---------
# Required in production: there is no anonymous default.
# ALLURA_MCP_SERVICE_PRINCIPAL_ID=svc-allura-memory
# ALLURA_MCP_SERVICE_TENANTS=allura-system      # comma separated, '*' forbidden in prod
# ALLURA_MCP_SERVICE_ROLES=viewer,curator

# --- Audit (AC-7) -----------------------------------------------------------
# Every auth decision is written to the append-only `events` table as
# event_type='mcp_auth_decision', with principal id / effective tenant / roles /
# session id / tool / decision / reason code in the metadata JSONB column. No
# schema change; raw tokens are never recorded. If the database is unreachable
# the decision is still emitted as a structured [mcp-auth] log line and the
# persistence failure is logged as [mcp-auth-persist-failed] - authentication
# never fails merely because auditing is down.

# --- Credential cache policy (AC-8) -----------------------------------------
# 0 (default) = no caching, so revocation takes effect on the very next request.
# Max 60000. Expiry is always evaluated live, regardless of this setting.
# ALLURA_MCP_AUTH_CACHE_TTL_MS=0

# =============================================================================
# Authentication — Clerk (production) / DevAuth (local)
# =============================================================================
# Allura uses Clerk RBAC in production and an explicitly enabled DevAuthProvider
# only outside production. When BOTH Clerk keys below are present, src/proxy.ts
# loads Clerk. Without both keys, production fails closed; non-production uses
# DevAuth only when ALLURA_DEV_AUTH_ENABLED=true.
#
# To ACTIVATE Clerk: paste both keys from https://dashboard.clerk.com
#   → API Keys, then set ALLURA_DEV_AUTH_ENABLED=false.
# Keep these out of git — put real values in .env.local (mode 600), not here.
#
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# CLERK_SECRET_KEY=sk_test_...
#
# Clerk URL config — point at Allura's existing auth routes:
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/v2/login
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/v2/register
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
#
# Per-user role + tenant + workspace come from Clerk publicMetadata.allura:
#   { "allura": { "role": "admin|curator|viewer", "groupId": "allura-<tenant>", "workspaceId": "<workspace-id>" } }
# Set that object on each user in the Clerk dashboard (or via the admin API).
# Then configure Clerk Dashboard -> Sessions -> Customize session token with:
#   { "allura": "{{user.public_metadata.allura}}" }
# The application reads this as auth().sessionClaims.allura and fails closed if
# role, groupId, or workspaceId is absent or malformed.
#
# DevAuth toggles (local only — ignored once Clerk is active in production):
ALLURA_DEV_AUTH_ENABLED=true
ALLURA_DEV_AUTH_ROLE=admin
ALLURA_DEV_AUTH_GROUP_ID=allura-system

# =============================================================================
# Multi-Tenant Defaults (development only)
# =============================================================================
NEXT_PUBLIC_DEFAULT_GROUP_ID=allura-system
NEXT_PUBLIC_DEFAULT_USER_ID=dev-user

# =============================================================================
# Curator (optional — defaults shown)
# =============================================================================
# AUTO_PROMOTE_ENABLED=false
# CURATOR_AGENT_ENABLED=true
# NOTION_SYNC_ENABLED=false  # disabled by default per sunset ADR 2026-07-02; set to "true" to re-enable notion_sync_pending emission

# =============================================================================
# Retention (days — optional, defaults shown)
# =============================================================================
# TRACE_RETENTION_DAYS=365
# INSIGHT_RETENTION_DAYS=0

# =============================================================================
# Channel Connectors (optional — WhatsApp / Telegram / Discord)
# =============================================================================
# WhatsApp Business API — see scripts/setup-whatsapp.ts
# WHATSAPP_PHONE_NUMBER_ID=<from Meta Developer Dashboard>
# WHATSAPP_BUSINESS_ACCOUNT_ID=<from Meta Developer Dashboard>
# WHATSAPP_ACCESS_TOKEN=<permanent access token from Meta>
# WHATSAPP_VERIFY_TOKEN=<custom token for webhook verification handshake>
# WHATSAPP_WEBHOOK_URL=https://your-domain.com/webhook/whatsapp
# WHATSAPP_USE_TUNNEL=false  # Set to 'true' for local dev with ngrok

# Telegram Bot API — see scripts/setup-telegram.ts
# TELEGRAM_BOT_TOKEN=<from @BotFather>
# TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram

# Discord Bot — placeholder only (connector not yet implemented)
# DISCORD_BOT_TOKEN=<from Discord Developer Portal — Coming soon>

# =============================================================================
# fal.ai — Image Generation API (optional — for brand/asset generation)
# =============================================================================
# Get your key from: https://fal.ai/dashboard/keys
# Supports: GPT Image 2 (text-to-image + edit), Ideogram V3, Flux, Kling, Veo
# FAL_API_KEY=<your-key-here>

# =============================================================================
# SOC2: TLS Configuration (required for production)
# =============================================================================
# POSTGRES_SSL_MODE=require
# NEO4J_ENCRYPTION=true
# ALLURA_ENCRYPTION_KEY=<operator-provided-key>

# =============================================================================
# Enterprise / Observability (optional — see docker-compose.enterprise.yml)
# =============================================================================
# OTEL_SERVICE_NAME=allura-memory
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# REDIS_HOST=localhost
# REDIS_PORT=6379

# =============================================================================
# Control plane defaults (referenced by docker-compose.yml)
# =============================================================================
# Compose supplies these via ${VAR:-default}, so they are optional. Documented
# here so the example matches what the stack actually reads.
DEFAULT_GROUP_ID=allura-system
RUVECTOR_EMBEDDING_MODEL=qwen3-embedding:0.6b
BUDGET_MAX_TIME_MS=604800000
BUDGET_MAX_STEPS=5000
BUDGET_MAX_RPM=120
BUDGET_MAX_TOKENS_PER_HOUR=500000
BUDGET_MAX_COST_USD=250.0
