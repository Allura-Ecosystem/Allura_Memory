# Allura Memory — Environment Variables Template
# Copy this to .env and fill in real values.
# DO NOT commit .env with real credentials.

# =============================================================================
# PostgreSQL (Episodic Store — required)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=allura
POSTGRES_USER=allura
POSTGRES_PASSWORD=<required — no default>
POSTGRES_POOL_MAX=10
DATABASE_URL=postgresql://allura:<required-password>@localhost:5432/allura

# =============================================================================
# Neo4j (Semantic Store — required)
# =============================================================================
# NEO4J_URI must use the bolt:// scheme for the neo4j-driver against a
# single-instance server. The neo4j:// scheme is the routing scheme for
# clusters and HANGS the bolt driver on a non-cluster server (proven
# 2026-06-12, see docs/governance/promotion-receipts/2026-06-12-neo4j-promotion-retry.md).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<required — no default>
NEO4J_DATABASE=neo4j

# =============================================================================
# Governance (required for promotion)
# =============================================================================
# Promotion mode: "soc2" (human-gated review) or "auto" (auto-promote at threshold)
PROMOTION_MODE=soc2
AUTO_APPROVAL_THRESHOLD=0.85

# =============================================================================
# Security (required for production)
# =============================================================================
JWT_SECRET=$(openssl rand -base64 32)
ENCRYPTION_KEY=$(openssl rand -hex 32)

# =============================================================================
# RuVix Kernel Secret (required for kernel protection)
# =============================================================================
RUVIX_KERNEL_SECRET=<required — minimum 32 characters for production>

# =============================================================================
# Ollama API (required for cloud embedding models)
# =============================================================================
OLLAMA_API_KEY=<required if using Ollama cloud — get from https://ollama.com/settings/keys>
OLLAMA_CLOUD_URL=https://ollama.com

# =============================================================================
# Embeddings (required for vector search)
# =============================================================================
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:8b
# Runtime embedding service URL used by RuVector embedding code.
# For host execution use http://localhost:11434.
# For Docker services use http://host.docker.internal:11434 with extra_hosts host-gateway.
RUVECTOR_EMBEDDING_BASE_URL=http://localhost:11434

# Alternative: OpenAI
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-your-key

# Alternative: Voyage
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_MODEL=voyage-3
# VOYAGE_API_KEY=your-voyage-key

# =============================================================================
# MCP HTTP Gateway (optional — defaults shown)
# =============================================================================
ALLURA_MCP_HTTP_PORT=3201
OPENCLAW_PORT=3201

# =============================================================================
# AC6 Multi-Tenant Governance — Cloudflare Access JWT verification
# Required on the direct-MCP surface (mcp.faithmeats.org).
# AC6 ADR §4.1.1 / Rule 4.1.4.
# =============================================================================
# Your Cloudflare Access team domain (from Zero Trust dashboard → Settings).
# Example: "yourteam.cloudflareaccess.com"
CF_ACCESS_TEAM_DOMAIN=<required for mcp.faithmeats.org — no default>

# Audience tag from your Cloudflare Access application (Applications → your app → Overview).
# The JWT aud claim must match this value. MANDATORY — absent = gateway rejects all JWTs.
# Example: "abc123def456..."
CF_ACCESS_AUD=<required for production — no default>

# Pre-shared secret for the mcpo → Brain MCP internal hop (chat surface).
# The mcpo bridge deployment MUST send this value in the X-Allura-Internal-Token
# header on every proxied request. Without it, the chat path is DENIED (default-deny).
# DEPLOY NOTE (Hightower): wire into mcpo container env + add header to proxied requests.
# Generate with: openssl rand -base64 32
ALLURA_INTERNAL_CHAT_TOKEN=<required for chat surface — no default>

# Dev-only bearer token bypass. When set, SKIPS Cloudflare Access JWT verification
# and pins all requests to synthetic identity dev@allura-dev / group_id=allura-dev.
# AC6 ADR §6.1 / §8.3: MUST NOT be set when NODE_ENV is not development/test/local.
# ALLURA_MCP_AUTH_TOKEN=dev-local-bypass-only

# =============================================================================
# Allura Guard MCP token signing (REQUIRED to mint/verify MCP bearer tokens)
# =============================================================================
# HMAC-SHA256 key used to hash MCP tokens (raw tokens are never stored). Must be
# >=16 chars. Generate with: openssl rand -base64 32
# Allura Guard refuses to mint or verify tokens if this is unset (fail-closed).
ALLURA_MCP_TOKEN_SECRET=<required — minimum 16 characters, e.g. openssl rand -base64 32>

# =============================================================================
# Multi-Tenant Defaults (development only)
# =============================================================================
NEXT_PUBLIC_DEFAULT_GROUP_ID=allura-system
NEXT_PUBLIC_DEFAULT_USER_ID=dev-user

# =============================================================================
# Curator (optional — defaults shown)
# =============================================================================
# AUTO_PROMOTE_ENABLED=false
# CURATOR_AGENT_ENABLED=true

# =============================================================================
# Retention (days — optional, defaults shown)
# =============================================================================
# TRACE_RETENTION_DAYS=365
# INSIGHT_RETENTION_DAYS=0

# =============================================================================
# Channel Connectors (optional — WhatsApp / Telegram / Discord)
# =============================================================================
# WhatsApp Business API — see scripts/setup-whatsapp.ts
# WHATSAPP_PHONE_NUMBER_ID=<from Meta Developer Dashboard>
# WHATSAPP_BUSINESS_ACCOUNT_ID=<from Meta Developer Dashboard>
# WHATSAPP_ACCESS_TOKEN=<permanent access token from Meta>
# WHATSAPP_VERIFY_TOKEN=<custom token for webhook verification handshake>
# WHATSAPP_WEBHOOK_URL=https://your-domain.com/webhook/whatsapp
# WHATSAPP_USE_TUNNEL=false  # Set to 'true' for local dev with ngrok

# Telegram Bot API — see scripts/setup-telegram.ts
# TELEGRAM_BOT_TOKEN=<from @BotFather>
# TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram

# Discord Bot — placeholder only (connector not yet implemented)
# DISCORD_BOT_TOKEN=<from Discord Developer Portal — Coming soon>

# =============================================================================
# fal.ai — Image Generation API (optional — for brand/asset generation)
# =============================================================================
# Get your key from: https://fal.ai/dashboard/keys
# Supports: GPT Image 2 (text-to-image + edit), Ideogram V3, Flux, Kling, Veo
# FAL_API_KEY=<your-key-here>

# =============================================================================
# SOC2: TLS Configuration (required for production)
# =============================================================================
# POSTGRES_SSL_MODE=require
# NEO4J_ENCRYPTION=true
# ALLURA_ENCRYPTION_KEY=<operator-provided-key>

# =============================================================================
# Enterprise / Observability (optional — see docker-compose.enterprise.yml)
# =============================================================================
# OTEL_SERVICE_NAME=allura-memory
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# REDIS_HOST=localhost
# REDIS_PORT=6379
