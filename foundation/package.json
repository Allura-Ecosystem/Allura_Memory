{
  "name": "@allura/local-foundation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14",
    "node": "24.19.0"
  },
  "scripts": {
    "check:toolchain": "bun scripts/check-toolchain.ts",
    "install:frozen": "bun run check:toolchain && bun install --frozen-lockfile --ignore-scripts",
    "test": "bun run check:toolchain && bun scripts/test.ts",
    "test:db": "bun run check:toolchain && bun scripts/test-db.ts",
    "typecheck": "bun run check:toolchain && node node_modules/typescript/bin/tsc --project tsconfig.json --noEmit && node node_modules/typescript/bin/tsc --project ui/tsconfig.json --noEmit",
    "lint": "bun run check:toolchain && node node_modules/eslint/bin/eslint.js src tests scripts ui eslint.config.mjs --max-warnings 0",
    "check": "bun run test && bun run typecheck && bun run lint",
    "check:all": "bun run check && bun run test:db",
    "ci": "bun scripts/ci.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.3.14",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@ruvector/core": "0.1.33",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
