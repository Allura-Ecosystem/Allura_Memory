# HTTP-only candidate. Existing Dockerfile.mcp/Compose/stdio remain unchanged.
FROM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS base

FROM base AS bundle
WORKDIR /build
COPY tsconfig.json ./
COPY src ./src
COPY packages ./packages
COPY scripts/build-gateway.ts ./scripts/build-gateway.ts
COPY deploy/gateway ./deploy/gateway
RUN bun --no-install scripts/build-gateway.ts /gateway-output

FROM base AS dependencies
WORKDIR /runtime
COPY deploy/gateway/package.json deploy/gateway/bun.lock deploy/gateway/bunfig.toml ./
RUN bun install --frozen-lockfile --production --ignore-scripts

FROM base AS runtime
WORKDIR /app
COPY --from=bundle /gateway-output/ ./
COPY --from=dependencies /runtime/node_modules ./node_modules
ENV NODE_ENV=production
USER bun
EXPOSE 3201
CMD ["bun", "--no-install", "gateway.mjs"]
